{
  "name": "@serdnaley/metabase-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.Serdnaley/metabase-mcp",
  "description": "Headless MCP server for Metabase: API-key auth (no OAuth), stdio or HTTP, 161 tools with toolsets, works on every Metabase tier",
  "type": "module",
  "scripts": {
    "generate-types": "bun run scripts/generate-types.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun run src/index.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:setup": "bun run tests/setup.ts",
    "docs": "bun run scripts/generate-docs.ts",
    "docs:readme": "bun run scripts/generate-docs.ts --readme",
    "docs:check": "bun run scripts/generate-docs.ts --check"
  },
  "bin": {
    "metabase-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "metabase",
    "mcp",
    "model-context-protocol",
    "ai",
    "dashboards",
    "metabase-mcp",
    "mcp-server",
    "bi",
    "analytics",
    "api-key",
    "headless"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Serdnaley/metabase-mcp"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.3.6"
  },
  "homepage": "https://serdnaley.github.io/metabase-mcp/",
  "bugs": {
    "url": "https://github.com/Serdnaley/metabase-mcp/issues"
  },
  "author": "Andres Pavliuk (https://github.com/Serdnaley)"
}
